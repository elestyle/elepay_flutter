<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust user-added CAs for HTTPS interception in debug builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Also permit cleartext HTTP during debug if needed -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

